<UserControl x:Class="Oan.App.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The pane's own styles live here rather than in the window: they are used nowhere else,
       and a StaticResource in a user control cannot reach the window's resources anyway. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Show" />

    <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,5" />
      <!-- IsCurrent lives on the row's data, which a ControlTemplate trigger cannot reach; Tag is
           the one property that carries it in. -->
      <Setter Property="Tag" Value="{Binding IsCurrent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <!-- Where you are, said quietly. A filled block shouts it every time you look at the
                   pane; a bar at the edge is enough to find and does not compete with the list.
                   It is also a shape and not only a colour, which is the half of the signal that
                   survives for someone who cannot tell these two hues apart. -->
              <Border x:Name="Mark" Width="3" CornerRadius="1.5" Opacity="0" Margin="0,4"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="{DynamicResource Accent}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DriveBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{DynamicResource Border}" CornerRadius="2" />
              <Rectangle x:Name="PART_Track" Fill="Transparent" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{DynamicResource Accent}" CornerRadius="2" />
            </Grid>
            <ControlTemplate.Triggers>
              <!-- Inside the template, not on the style: a style trigger cannot reach a part. -->
              <DataTrigger Binding="{Binding NearlyFull}" Value="True">
                <Setter TargetName="PART_Indicator" Property="Background"
                        Value="{DynamicResource Warning}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding UsedFraction}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="10,10,0,4" />
    </Style>

    <Style x:Key="SideNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource ChromeBar}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="6,0,2,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,1" Margin="0,8,4,0"
                  Command="{Binding Places.MeasureAllCommand}"
                  ToolTip="Measure folder sizes — the home folder can take about a minute">
            <TextBlock Text="Sizes" FontSize="11" Foreground="{DynamicResource Accent}" />
          </Button>
          <TextBlock Text="Quick access" Style="{StaticResource SectionLabel}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Places.Quick}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                      CommandParameter="{Binding Path}" ToolTip="{Binding Tip}"
                      Command="{Binding DataContext.OpenPlaceCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Margin="8,0,0,0"
                             Style="{StaticResource SideNote}" />
                  <Grid Width="16" Height="16">
                    <TextBlock x:Name="Fallback" Style="{StaticResource Glyph}" Text="&#xE8B7;"
                               Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                    <Image x:Name="Shell" Source="{Binding Icon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Button>
              <DataTemplate.Triggers>
                <!-- Until the shell answers, and for anything it has no icon for. -->
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                  <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True"
                             Binding="{Binding DataContext.Look.PlainIcons,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Shell" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="This PC" Style="{StaticResource SectionLabel}" />
        <ItemsControl ItemsSource="{Binding Places.Drives}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <!-- A line, not a heading. The drives above are the machine's; below it is
                     something the user mounted, and that is a different kind of thing. -->
                <Border x:Name="Rule" Height="1" Margin="12,8,12,7" Visibility="Collapsed"
                        Background="{DynamicResource Border}" />
                <DockPanel>
                  <Button x:Name="EjectButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                          Padding="6,1" ToolTip="Unmount" Visibility="Collapsed"
                          CommandParameter="{Binding Image}"
                          Command="{Binding DataContext.Mounts.UnmountCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="Eject" FontSize="11" Foreground="{DynamicResource Accent}" />
                  </Button>
                  <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                          CommandParameter="{Binding Path}" ToolTip="{Binding Tip}"
                          Command="{Binding DataContext.OpenPlaceCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16">
                          <TextBlock x:Name="DriveGlyph" Style="{StaticResource Glyph}" Text="&#xEDA2;"
                                     Foreground="{DynamicResource FgMuted}" Visibility="Collapsed" />
                          <Image x:Name="DriveShell" Source="{Binding Icon}"
                                 RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <!-- A mounted image is always full, so its bar is a solid block saying nothing. -->
                      <ProgressBar x:Name="Bar" Style="{StaticResource DriveBar}" Margin="24,5,4,2"
                                   Value="{Binding UsedFraction, Mode=OneWay, FallbackValue=0}" />
                      <TextBlock Text="{Binding CapacityText}" Margin="24,0,4,2"
                                 Style="{StaticResource SideNote}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <!-- Until the shell answers, and for a drive it has no icon for. -->
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                  <Setter TargetName="DriveGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True"
                             Binding="{Binding DataContext.Look.PlainIcons,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Setter TargetName="DriveGlyph" Property="Visibility" Value="Visible" />
                  <Setter TargetName="DriveShell" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOptical}" Value="True">
                  <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Rule" Property="Visibility" Value="Visible" />
                  <!-- A disc, not a drive platter. -->
                  <Setter TargetName="DriveGlyph" Property="Text" Value="&#xE958;" />
                  <Setter TargetName="DriveGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <!-- Eject only on an image OAN attached: the Core refuses to detach any other,
                     and offering what will be refused is worse than not offering it. -->
                <DataTrigger Binding="{Binding IsOurs}" Value="True">
                  <Setter TargetName="EjectButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
