<UserControl x:Class="Oan.App.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The pane's own styles live here rather than in the window: they are used nowhere else,
       and a StaticResource in a user control cannot reach the window's resources anyway. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Show" />

    <Style x:Key="DriveBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{DynamicResource Border}" CornerRadius="2" />
              <Rectangle x:Name="PART_Track" Fill="Transparent" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{DynamicResource Accent}" CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding UsedFraction}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="10,10,0,4" />
    </Style>

    <Style x:Key="SideNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource ChromeBar}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="6,0,2,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,1" Margin="0,8,4,0"
                  Command="{Binding MeasureSizesCommand}"
                  ToolTip="Measure folder sizes — the home folder can take about a minute">
            <TextBlock Text="Sizes" FontSize="11" Foreground="{DynamicResource Accent}" />
          </Button>
          <TextBlock Text="Quick access" Style="{StaticResource SectionLabel}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Quick}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                      CommandParameter="{Binding Path}" ToolTip="{Binding Tip}"
                      Command="{Binding DataContext.OpenPlaceCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Margin="8,0,0,0"
                             Style="{StaticResource SideNote}" />
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="This PC" Style="{StaticResource SectionLabel}" />
        <ItemsControl ItemsSource="{Binding Drives}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                      CommandParameter="{Binding Path}" ToolTip="{Binding Path}"
                      Command="{Binding DataContext.OpenPlaceCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Foreground="{DynamicResource FgMuted}" />
                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ProgressBar Style="{StaticResource DriveBar}" Margin="24,5,4,2"
                               Value="{Binding UsedFraction, Mode=OneWay, FallbackValue=0}" />
                  <TextBlock Text="{Binding CapacityText}" Margin="24,0,4,2"
                             Style="{StaticResource SideNote}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding Mounts.Any, Converter={StaticResource Show}}">
          <TextBlock Text="Mounted" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding Mounts.Images}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <!-- Only images OAN attached are listed, so Eject is never offered for one the
                       Core would refuse to detach — the user's own virtual disks stay theirs. -->
                  <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,1"
                          ToolTip="Unmount" CommandParameter="{Binding IsoPath}"
                          Command="{Binding DataContext.Mounts.UnmountCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="Eject" FontSize="11" Foreground="{DynamicResource Accent}" />
                  </Button>
                  <Button Style="{StaticResource SideButton}" IsEnabled="{Binding HasLetter}"
                          CommandParameter="{Binding Root}" ToolTip="{Binding Tip}"
                          Command="{Binding DataContext.OpenPlaceCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <DockPanel>
                      <!-- An em dash until Windows gives the volume a letter. Never blank: a
                           blank would read as a mount that worked and went somewhere. -->
                      <TextBlock DockPanel.Dock="Right" Text="{Binding LetterText}" Margin="8,0,0,0"
                                 Style="{StaticResource SideNote}" />
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Foreground="{DynamicResource Accent}" />
                      <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </Button>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
