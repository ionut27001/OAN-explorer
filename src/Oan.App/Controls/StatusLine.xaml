<UserControl x:Class="Oan.App.Controls.StatusLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Left to right: what is here, what just went right, what went wrong. Free space on the far side. -->
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,6" Style="{StaticResource ChromeBar}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Places.FreeText}" Foreground="{DynamicResource FgMuted}" />
      <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{DynamicResource FgMuted}" />
      <TextBlock DockPanel.Dock="Left" Text="{Binding InfoText}" Margin="16,0,0,0" Foreground="{DynamicResource Accent}" />
      <TextBlock Text="{Binding WarningText}" Margin="16,0,16,0" Foreground="{DynamicResource Warning}"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Border>
</UserControl>
