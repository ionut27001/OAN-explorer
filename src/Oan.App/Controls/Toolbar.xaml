<UserControl x:Class="Oan.App.Controls.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Oan.App.ViewModels"
             xmlns:pf="clr-namespace:Oan.App.Platform">

  <Border Padding="8,0,8,8" Style="{StaticResource ChromeBar}"
          BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
    <DockPanel>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}"
              ToolTip="New folder (Ctrl+Shift+N)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
          <TextBlock Text="New folder" Margin="6,0,0,0" />
        </StackPanel>
      </Button>

      <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding CutCommand}" ToolTip="Cut (Ctrl+X)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
          <TextBlock Text="Cut" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding CopyCommand}" ToolTip="Copy (Ctrl+C)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
          <TextBlock Text="Copy" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding PasteCommand}" ToolTip="Paste (Ctrl+V)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
          <TextBlock Text="Paste" Margin="6,0,0,0" />
        </StackPanel>
      </Button>

      <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding RenameCommand}" ToolTip="Rename (F2)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" />
          <TextBlock Text="Rename" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}"
              ToolTip="Delete — Shift+Delete deletes permanently">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
          <TextBlock Text="Delete" Margin="6,0,0,0" />
        </StackPanel>
      </Button>

      <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnMenuButtonClick"
              ToolTip="How the folder is shown (Ctrl+wheel steps through these)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" />
          <TextBlock Text="View" Margin="6,0,0,0" />
        </StackPanel>
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Details" Command="{Binding Look.ViewCommand}" CommandParameter="0"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=0}" />
            <MenuItem Header="List" Command="{Binding Look.ViewCommand}" CommandParameter="1"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=1}" />
            <Separator />
            <MenuItem Header="Small icons" Command="{Binding Look.ViewCommand}" CommandParameter="32"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=32}" />
            <MenuItem Header="Medium icons" Command="{Binding Look.ViewCommand}" CommandParameter="48"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=48}" />
            <MenuItem Header="Large icons" Command="{Binding Look.ViewCommand}" CommandParameter="96"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=96}" />
            <MenuItem Header="Extra large icons" Command="{Binding Look.ViewCommand}" CommandParameter="256"
                      IsChecked="{Binding Look.View, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=256}" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>

      <!-- The map draws the sizes the column measured, so it is disabled without them. -->
      <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}"
                    IsChecked="{Binding Look.Treemap}" IsEnabled="{Binding FolderSizes.On}"
                    ToolTip="Show this folder as areas, biggest first">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" />
          <TextBlock Text="Map" Margin="6,0,0,0" />
        </StackPanel>
      </ToggleButton>

      <!-- A folder's size is a full walk of everything under it. Measured, the whole user profile is 7.4s. -->
      <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}"
                    IsChecked="{Binding FolderSizes.On}"
                    ToolTip="Measure folder sizes in this folder (walks every file below them)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D5;" />
          <TextBlock Text="Sizes" Margin="6,0,0,0" />
        </StackPanel>
      </ToggleButton>

      <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}"
                    IsChecked="{Binding ShowHidden}" ToolTip="Show hidden and system items">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;" />
          <TextBlock Text="Hidden" Margin="6,0,0,0" />
        </StackPanel>
      </ToggleButton>

      <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnMenuButtonClick" ToolTip="Sort by">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
          <TextBlock Text="Sort" Margin="6,0,0,0" />
        </StackPanel>
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Name" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Name}" />
            <MenuItem Header="Size" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Size}" />
            <MenuItem Header="Type" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Kind}" />
            <MenuItem Header="Date modified" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Modified}" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>

      <Border />
    </DockPanel>
  </Border>
</UserControl>
