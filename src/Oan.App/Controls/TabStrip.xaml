<UserControl x:Class="Oan.App.Controls.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Oan.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Show" />
  </UserControl.Resources>

  <Border DockPanel.Dock="Top" Padding="2,0,6,0" Style="{StaticResource ChromeBar}"
  >
        <DockPanel>
        <Button DockPanel.Dock="Right" HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                Padding="8,4" Margin="4,0,0,0" ToolTip="New tab (Ctrl+T)"
                Command="{Binding Tabs.NewTabCommand}">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE710;" />
        </Button>
        <ItemsControl ItemsSource="{Binding Tabs.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Chip" Margin="0,0,4,0" CornerRadius="5,5,0,0" Padding="10,5"
                      Background="Transparent" MouseDown="OnTabMouseDown" MouseMove="OnTabMouseMove"
                      AllowDrop="True" Drop="OnTabDrop" ToolTip="{Binding Path}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button x:Name="CloseChip" Margin="8,0,0,0" Padding="3,0" Style="{StaticResource FlatButton}"
                          ToolTip="Close tab (Ctrl+W)" CommandParameter="{Binding}"
                          Command="{Binding DataContext.Tabs.CloseTabCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE711;" />
                  </Button>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <!-- The last tab cannot be closed, so it does not get a button that would do
                     nothing. An X that is there and inert is the defect this project hunts. -->
                <DataTrigger Value="False"
                             Binding="{Binding DataContext.Tabs.CanClose,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Setter TargetName="CloseChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Surface}" />
                </DataTrigger>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </DockPanel>
      </Border>
</UserControl>
