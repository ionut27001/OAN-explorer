<Window x:Class="Oan.App.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pf="clr-namespace:Oan.App.Platform"
        xmlns:vm="clr-namespace:Oan.App.ViewModels"
        Title="Settings" Width="520" Height="560" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Show" />
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="24,2,0,10" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Button Content="Close" HorizontalAlignment="Right" Padding="22,5"
              IsCancel="True" IsDefault="True" Style="{StaticResource ToolButton}" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,4">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="WINDOW MATERIAL" Style="{StaticResource Section}" />
            <RadioButton GroupName="Backdrop" Content="Mica" IsEnabled="{Binding Look.CanPickMaterial}"
                         IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Mica}" />
            <RadioButton GroupName="Backdrop" Content="Mica Alt — what Windows uses for tabbed windows"
                         IsEnabled="{Binding Look.CanPickMaterial}"
                         IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=MicaAlt}" />
            <RadioButton GroupName="Backdrop" Content="Acrylic — blurs whatever is behind the window"
                         IsEnabled="{Binding Look.CanPickMaterial}"
                         IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Acrylic}" />
            <RadioButton GroupName="Backdrop" Content="Solid"
                         IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Solid}" />
            <CheckBox Content="Glass: the window as separate slabs" IsChecked="{Binding Look.Glass}" Margin="0,12,0,0"
                      IsEnabled="{Binding Look.Supported}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="Each bar and pane becomes its own piece of acrylic with a lit, tinted edge, and what is between them is really a gap: the desktop shows through and can be clicked. Uses acrylic whatever is chosen above." />
            <TextBlock Text="{Binding Look.Note}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                  <Setter Property="Margin" Value="0,10,0,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Look.Note}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="THEME" Style="{StaticResource Section}" />
            <ItemsControl ItemsSource="{Binding Look.Themes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="Theme" Content="{Binding Label}" IsChecked="{Binding Current, Mode=OneWay}"
                               Command="{Binding DataContext.Look.ChooseThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Open themes folder" Command="{Binding Look.OpenThemesCommand}" HorizontalAlignment="Left"
                    Padding="16,5" Margin="0,10,0,0" Style="{StaticResource ToolButton}" />
            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                       Text="A theme is a .json file of colours in that folder. Example.json lists every colour there is with the value it has now: copy it, rename it, change what you like." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ICONS" Style="{StaticResource Section}" />
            <RadioButton GroupName="Icons" Content="Windows"
                         IsChecked="{Binding Look.Icons, Converter={StaticResource Is}, ConverterParameter=Windows}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="The shell's own, so Downloads, Pictures and a folder you gave your own icon each keep theirs." />
            <RadioButton GroupName="Icons" Content="Simple"
                         IsChecked="{Binding Look.Icons, Converter={StaticResource Is}, ConverterParameter=Simple}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="One flat glyph in the accent colour, the same for every folder. Sidebar and tabs only — a row in the list is a specific file, and a glyph there would say less." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="FOLDERS" Style="{StaticResource Section}" />
            <CheckBox Content="Show hidden and system items" IsChecked="{Binding ShowHidden}" />
            <TextBlock Text="The ones Windows keeps out of the way by default." Style="{StaticResource Note}" />

            <CheckBox Content="Measure folder sizes" IsChecked="{Binding FolderSizes.On}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="A folder's size means walking every file under it — there is no cheaper way without administrator. Measured here: the whole user profile is 7.4 seconds and 1.1 million files, and it is re-measured when the disk changes underneath it." />

            <CheckBox Content="Show the size map under the list" IsChecked="{Binding Look.Treemap}"
                      IsEnabled="{Binding FolderSizes.On}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="Draws those sizes as areas, biggest first. It needs them, so it is off when they are." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <Border.DataContext>
            <vm:SevenZipViewModel />
          </Border.DataContext>
          <StackPanel>
            <TextBlock Text="ARCHIVES" Style="{StaticResource Section}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <Button Content="Install 7-Zip" Command="{Binding InstallCommand}" HorizontalAlignment="Left"
                    Padding="16,5" Margin="0,10,0,0" Style="{StaticResource ToolButton}"
                    Visibility="{Binding Missing, Converter={StaticResource Show}}" />
            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                       Visibility="{Binding Missing, Converter={StaticResource Show}}"
                       Text="Free and open source, from 7-zip.org, fetched by winget. OAN uses the one you install and ships none of its own." />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Warning}"
                       Visibility="{Binding HasNote, Converter={StaticResource Show}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="NOT HERE ON PURPOSE" Style="{StaticResource Section}" />
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0"
                       Text="The view size, the sort order and the filters live on the toolbar. They are things you change while looking at a folder, not things you set once — putting them behind a window would mean opening it every time." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
