<Window x:Class="Oan.App.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Oan.App.Controls"
        xmlns:pf="clr-namespace:Oan.App.Platform"
        Title="Settings" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="22,1,0,8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,12,20,20">
    <TextBlock Text="WINDOW" Style="{StaticResource Section}" Margin="0,4,0,6" />

    <!-- The same four the toolbar's droplet offers, because a setting a window claims to hold and
         does not is worse than a window with one section. -->
    <RadioButton Content="Mica" IsEnabled="{Binding Look.Supported}"
                 IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Mica}" />
    <RadioButton Content="Mica Alt" IsEnabled="{Binding Look.Supported}"
                 IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=MicaAlt}" />
    <RadioButton Content="Acrylic" IsEnabled="{Binding Look.Supported}"
                 IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Acrylic}" />
    <RadioButton Content="Solid"
                 IsChecked="{Binding Look.Backdrop, Converter={StaticResource Is}, ConverterParameter=Solid}" />
    <TextBlock Text="{Binding Look.Note}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
          <Setter Property="Margin" Value="22,8,0,0" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Look.Note}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <TextBlock Text="FOLDERS" Style="{StaticResource Section}" />

    <CheckBox Content="Show hidden and system items" IsChecked="{Binding ShowHidden}" />
    <TextBlock Text="The ones Windows keeps out of the way by default." Style="{StaticResource Note}" />

    <CheckBox Content="Measure folder sizes" IsChecked="{Binding FolderSizes.On}" />
    <TextBlock Style="{StaticResource Note}"
               Text="A folder's size means walking every file under it — there is no cheaper way without administrator. Measured here: the whole user profile is 7.4 seconds and 1.1 million files." />

    <CheckBox Content="Show the size map under the list" IsChecked="{Binding Look.Treemap}"
              IsEnabled="{Binding FolderSizes.On}" />
    <TextBlock Style="{StaticResource Note}"
               Text="Draws the sizes measured above as areas, so it needs them. Off when they are." />

    <Button Content="Close" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="20,5"
            IsCancel="True" IsDefault="True" Style="{StaticResource ToolButton}" />
  </StackPanel>
</Window>
