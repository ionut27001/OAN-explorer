<Window x:Class="Oan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Oan.App.ViewModels"
        xmlns:ctl="clr-namespace:Oan.App.Controls"
        xmlns:pf="clr-namespace:Oan.App.Platform"
        Title="OAN" Width="1120" Height="700" MinWidth="700" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" PreviewKeyDown="OnWindowKeyDown">

  <Window.Resources>
    <ctl:IsConverter x:Key="Is" />
    <BooleanToVisibilityConverter x:Key="Show" />

    <DataTemplate x:Key="NameHeaderTemplate">
      <TextBlock Text="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="SizeHeaderTemplate">
      <TextBlock Text="{Binding DataContext.SizeHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="KindHeaderTemplate">
      <TextBlock Text="{Binding DataContext.KindHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="ModifiedHeaderTemplate">
      <TextBlock Text="{Binding DataContext.ModifiedHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>

    <GridView x:Key="DetailsView" AllowsColumnReorder="False">
      <GridViewColumn Header="Name" HeaderTemplate="{StaticResource NameHeaderTemplate}" Width="380">
        <GridViewColumn.CellTemplate>
          <DataTemplate>
            <StackPanel x:Name="Cell" Orientation="Horizontal">
              <Image Width="16" Height="16" Margin="0,0,10,0" Source="{Binding Icon}"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter TargetName="Cell" Property="Opacity" Value="0.55" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </GridViewColumn.CellTemplate>
      </GridViewColumn>

      <GridViewColumn Header="Size" HeaderTemplate="{StaticResource SizeHeaderTemplate}" Width="100">
        <GridViewColumn.CellTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,10,0" />
          </DataTemplate>
        </GridViewColumn.CellTemplate>
      </GridViewColumn>

      <GridViewColumn Header="Kind" HeaderTemplate="{StaticResource KindHeaderTemplate}" Width="140"
                      DisplayMemberBinding="{Binding KindText}" />
      <GridViewColumn Header="Modified" HeaderTemplate="{StaticResource ModifiedHeaderTemplate}" Width="170"
                      DisplayMemberBinding="{Binding ModifiedText}" />
    </GridView>

    <!-- The icon is sized explicitly rather than by the bitmap: a 256px request can legitimately
         come back as a cropped 48px image, and a tile that sized itself would then be a small
         icon standing next to large ones. -->
    <DataTemplate x:Key="TileTemplate">
      <StackPanel x:Name="Tile" Margin="4,8,4,0">
        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
               Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListView}}"
               Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListView}}" />
        <TextBlock Text="{Binding Name}" Margin="2,6,2,0" MaxHeight="34"
                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="TilePanel">
      <ctl:VirtualizingWrapPanel ItemWidth="{Binding TileWidth}" ItemHeight="{Binding TileHeight}" />
    </ItemsPanelTemplate>

    <!-- Container style and panel switch together, set here rather than on the ListView because a
         local value on the element would outrank the trigger. The View is the exception: it is
         assigned in code-behind, because a ListView rejects a GridView that is already in use and
         a style re-applies its value whenever a trigger re-evaluates. -->
    <Style x:Key="FileList" TargetType="ListView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource Row}" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDetails}" Value="False">
          <Setter Property="ItemContainerStyle" Value="{StaticResource Tile}" />
          <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}" />
          <Setter Property="ItemsPanel" Value="{StaticResource TilePanel}" />
          <!-- The wrap panel releases containers rather than recycling them. -->
          <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Sits inside the search box. It clears the kind filter as well, because one control that
         says "clear" and leaves half the items hidden is worse than no control at all. -->
    <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Filtering}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding KindFiltered}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Selected}" />
          <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KindLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding KindFilterText}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- Window scope for everything a text box does not already claim, so the toolbar tooltips
       are true wherever the focus happens to be. The rest stay on the list, where Delete and
       Enter mean the selection and not the text being typed. -->
  <Window.InputBindings>
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}" />
    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewFolderCommand}" />
  </Window.InputBindings>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,8,8,4" Style="{StaticResource ChromeBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" Margin="8,0" Height="30" CornerRadius="4"
                Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" MouseLeftButtonDown="OnAddressBarClick">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Crumbs}" Margin="2,0" HorizontalAlignment="Left">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding EditingAddress}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}"
                              CommandParameter="{Binding Path}"
                              Command="{Binding DataContext.OpenPlaceCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                      <TextBlock Text="&#xE76C;" FontSize="9" VerticalAlignment="Center"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Foreground="{DynamicResource FgDim}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBox x:Name="AddressBox" BorderThickness="0" Background="Transparent" Padding="8,0"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnAddressKeyDown" LostKeyboardFocus="OnAddressLostFocus">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EditingAddress}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
          </Grid>
        </Border>

        <Grid Grid.Column="2" Width="300">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="SearchBox" Height="30" AutomationProperties.Name="Search this folder"
                   Padding="10,0,28,0"
                   Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}">
            <!-- Typing filters what is already loaded; Enter walks the tree. The two are
                 different questions and the placeholder says so, because a box labelled
                 "search" that only hides loaded rows is the reason this was reported broken. -->
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              <KeyBinding Key="Escape" Command="{Binding EndSearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Text="Filter here · Enter searches subfolders" Margin="10,0,0,0" VerticalAlignment="Center"
                     IsHitTestVisible="False" Foreground="{DynamicResource FgDim}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Filter}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <Button Style="{StaticResource ClearButton}" Command="{Binding ClearFiltersCommand}"
                  ToolTip="Clear the filters">
            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE711;" />
          </Button>

          <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource FilterButton}"
                  Click="OnMenuButtonClick" ToolTip="Filter by type">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" />
              <TextBlock Text="{Binding KindFilterText}" Style="{StaticResource KindLabel}" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="All types" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.All}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=All}" />
                <Separator />
                <MenuItem Header="Folders" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Folders}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Folders}" />
                <MenuItem Header="Documents" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Documents}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Documents}" />
                <MenuItem Header="Images" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Images}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Images}" />
                <MenuItem Header="Audio" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Audio}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Audio}" />
                <MenuItem Header="Video" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Video}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Video}" />
                <MenuItem Header="Archives" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Archives}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Archives}" />
                <MenuItem Header="Code" Command="{Binding KindCommand}" CommandParameter="{x:Static pf:FileKind.Code}"
                          IsChecked="{Binding KindFilter, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Code}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="8,0,8,8" Style="{StaticResource ChromeBar}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}"
                ToolTip="New folder (Ctrl+Shift+N)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
            <TextBlock Text="New folder" Margin="6,0,0,0" />
          </StackPanel>
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding CutCommand}" ToolTip="Cut (Ctrl+X)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="Copy (Ctrl+C)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" ToolTip="Paste (Ctrl+V)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding RenameCommand}" ToolTip="Rename (F2)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                ToolTip="Delete — Shift+Delete deletes permanently">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
        </Button>

        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnMenuButtonClick"
                ToolTip="Window transparency">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" />
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Mica" IsEnabled="{Binding BackdropSupported}"
                        Command="{Binding BackdropCommand}" CommandParameter="{x:Static pf:Backdrop.Mica}"
                        IsChecked="{Binding Backdrop, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Mica}" />
              <MenuItem Header="Acrylic" IsEnabled="{Binding BackdropSupported}"
                        Command="{Binding BackdropCommand}" CommandParameter="{x:Static pf:Backdrop.Acrylic}"
                        IsChecked="{Binding Backdrop, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Acrylic}" />
              <MenuItem Header="Solid"
                        Command="{Binding BackdropCommand}" CommandParameter="{x:Static pf:Backdrop.Solid}"
                        IsChecked="{Binding Backdrop, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter=Solid}" />
              <MenuItem Header="{Binding BackdropNote}" IsEnabled="False">
                <MenuItem.Style>
                  <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BackdropNote}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </MenuItem.Style>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="2" CornerRadius="5"
                Background="{DynamicResource Hover}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="IconSize" ToolTip="Details — 16 px icons"
                         IsChecked="{Binding IconSize, Converter={StaticResource Is}, ConverterParameter=16}">
              <StackPanel>
                <Rectangle Width="13" Height="2" Margin="0,0,0,3" Fill="{DynamicResource Fg}" />
                <Rectangle Width="13" Height="2" Margin="0,0,0,3" Fill="{DynamicResource Fg}" />
                <Rectangle Width="13" Height="2" Fill="{DynamicResource Fg}" />
              </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" GroupName="IconSize" ToolTip="Medium icons — 32 px"
                         IsChecked="{Binding IconSize, Converter={StaticResource Is}, ConverterParameter=32}">
              <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{DynamicResource Fg}" />
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" GroupName="IconSize" ToolTip="Large icons — 48 px"
                         IsChecked="{Binding IconSize, Converter={StaticResource Is}, ConverterParameter=48}">
              <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource Fg}" />
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" GroupName="IconSize" ToolTip="Extra large icons — 256 px"
                         IsChecked="{Binding IconSize, Converter={StaticResource Is}, ConverterParameter=256}">
              <Rectangle Width="16" Height="16" RadiusX="2" RadiusY="2" Fill="{DynamicResource Fg}" />
            </RadioButton>
          </StackPanel>
        </Border>

        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}"
                      IsChecked="{Binding ShowHidden}" ToolTip="Show hidden and system items">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;" />
            <TextBlock Text="Hidden" Margin="6,0,0,0" />
          </StackPanel>
        </ToggleButton>

        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnMenuButtonClick" ToolTip="Sort by">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
            <TextBlock Text="Sort" Margin="6,0,0,0" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Name" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Name}" />
              <MenuItem Header="Size" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Size}" />
              <MenuItem Header="Type" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Kind}" />
              <MenuItem Header="Date modified" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Modified}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <Border />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Padding="12,6" Style="{StaticResource ChromeBar}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Places.FreeText}" Foreground="{DynamicResource FgMuted}" />
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgMuted}" />
        <TextBlock Text="{Binding WarningText}" Margin="16,0,16,0" Foreground="{DynamicResource Warning}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid x:Name="Body" SizeChanged="OnBodySizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="150" />
        <ColumnDefinition Width="Auto" />
        <!-- No MinWidth here: a minimum on both sides means neither can yield, and the grid
             answers by overflowing the window. The list's floor is enforced in code instead,
             against the width the window actually has. -->
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ctl:Sidebar />

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                    DragCompleted="OnSplitterDragged" />

      <!-- The one opaque surface in the window. Text over a wallpaper reads at whatever contrast
           the wallpaper happens to have, so the backdrop stops at the edge of the list. -->
      <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1,1,0,0" CornerRadius="4,0,0,0" ClipToBounds="True">
        <Grid>
          <ListView x:Name="List" ItemsSource="{Binding Rows}" Style="{StaticResource FileList}"
                    SelectionMode="Extended"
                    IsTextSearchEnabled="True" TextSearch.TextPath="Name" AllowDrop="True"
                    SelectionChanged="OnSelectionChanged"
                    MouseDoubleClick="OnListDoubleClick"
                    PreviewMouseLeftButtonDown="OnListMouseDown"
                    PreviewMouseRightButtonDown="OnListRightButtonDown"
                    PreviewMouseMove="OnListMouseMove"
                    PreviewMouseLeftButtonUp="OnListMouseUp"
                    ContextMenuOpening="OnListContextMenuOpening"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop"
                    GridViewColumnHeader.Click="OnHeaderClick">

            <ListView.InputBindings>
              <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
              <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
              <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentlyCommand}" />
              <KeyBinding Key="Enter" Command="{Binding OpenSelectionCommand}" />
              <KeyBinding Key="Back" Command="{Binding UpCommand}" />
            </ListView.InputBindings>

            <ListView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open" Command="{Binding OpenSelectionCommand}" InputGestureText="Enter" />
                <!-- Mount is OAN's own, through the VirtDisk API: no shell extension is loaded,
                     which is the whole reason this menu exists on this machine. -->
                <MenuItem Header="{Binding Mounts.MountHeader}" Command="{Binding Mounts.MountCommand}"
                          Visibility="{Binding Mounts.ShowMount, Converter={StaticResource Show}}" />
                <Separator />
                <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                <MenuItem Header="Delete permanently" Command="{Binding DeletePermanentlyCommand}" InputGestureText="Shift+Del" />
                <Separator />
                <MenuItem Header="New" ItemsSource="{Binding NewItems}">
                  <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Setter Property="Header" Value="{Binding Label}" />
                      <Setter Property="InputGestureText" Value="{Binding Gesture}" />
                      <Setter Property="Command" Value="{Binding Command}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                  </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Properties" Click="OnPropertiesClick" IsEnabled="{Binding HasSelection}" />
              </ContextMenu>
            </ListView.ContextMenu>
          </ListView>

          <TextBlock Text="{Binding ListMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="24,60,24,0" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource FgMuted}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
