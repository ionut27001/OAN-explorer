<Window x:Class="Oan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Oan.App.ViewModels"
        Title="OAN" Width="1120" Height="700" MinWidth="700" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" PreviewKeyDown="OnWindowKeyDown">

  <Window.Resources>
    <DataTemplate x:Key="NameHeaderTemplate">
      <TextBlock Text="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="SizeHeaderTemplate">
      <TextBlock Text="{Binding DataContext.SizeHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="KindHeaderTemplate">
      <TextBlock Text="{Binding DataContext.KindHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>
    <DataTemplate x:Key="ModifiedHeaderTemplate">
      <TextBlock Text="{Binding DataContext.ModifiedHeader, RelativeSource={RelativeSource AncestorType=ListView}}" />
    </DataTemplate>

    <Style x:Key="DriveBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{DynamicResource Border}" CornerRadius="2" />
              <Rectangle x:Name="PART_Track" Fill="Transparent" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{DynamicResource Accent}" CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding UsedFraction}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="10,10,0,4" />
    </Style>
  </Window.Resources>

  <!-- Window scope for everything a text box does not already claim, so the toolbar tooltips
       are true wherever the focus happens to be. The rest stay on the list, where Delete and
       Enter mean the selection and not the text being typed. -->
  <Window.InputBindings>
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}" />
    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewFolderCommand}" />
  </Window.InputBindings>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,8,8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" Margin="8,0" Height="30" CornerRadius="4"
                Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" MouseLeftButtonDown="OnAddressBarClick">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Crumbs}" Margin="2,0" HorizontalAlignment="Left">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding EditingAddress}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}"
                              CommandParameter="{Binding Path}"
                              Command="{Binding DataContext.OpenPlaceCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                      <TextBlock Text="&#xE76C;" FontSize="9" VerticalAlignment="Center"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 Foreground="{DynamicResource FgDim}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBox x:Name="AddressBox" BorderThickness="0" Background="Transparent" Padding="8,0"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnAddressKeyDown" LostKeyboardFocus="OnAddressLostFocus">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EditingAddress}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
          </Grid>
        </Border>

        <Grid Grid.Column="2" Width="210">
          <TextBox Height="30" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
          <TextBlock Text="Search this folder" Margin="10,0,0,0" VerticalAlignment="Center"
                     IsHitTestVisible="False" Foreground="{DynamicResource FgDim}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Filter}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="8,0,8,8">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding NewFolderCommand}"
                ToolTip="New folder (Ctrl+Shift+N)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
            <TextBlock Text="New folder" Margin="6,0,0,0" />
          </StackPanel>
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding CutCommand}" ToolTip="Cut (Ctrl+X)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="Copy (Ctrl+C)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" ToolTip="Paste (Ctrl+V)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="8,0" Background="{DynamicResource Border}" />

        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding RenameCommand}" ToolTip="Rename (F2)">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" />
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                ToolTip="Delete — Shift+Delete deletes permanently">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
        </Button>

        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}"
                      IsChecked="{Binding ShowHidden}" ToolTip="Show hidden and system items">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;" />
            <TextBlock Text="Hidden" Margin="6,0,0,0" />
          </StackPanel>
        </ToggleButton>

        <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnSortButtonClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
            <TextBlock Text="Sort" Margin="6,0,0,0" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Name" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Name}" />
              <MenuItem Header="Size" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Size}" />
              <MenuItem Header="Type" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Kind}" />
              <MenuItem Header="Date modified" Command="{Binding SortCommand}" CommandParameter="{x:Static vm:SortKey.Modified}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <Border />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            Padding="12,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Foreground="{DynamicResource FgMuted}" />
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgMuted}" />
        <TextBlock Text="{Binding WarningText}" Margin="16,0,16,0" Foreground="{DynamicResource Warning}"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="150" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,2,8">
          <TextBlock Text="Quick access" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding Quick}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                        CommandParameter="{Binding Path}" ToolTip="{Binding Path}"
                        Command="{Binding DataContext.OpenPlaceCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="This PC" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SideButton}" IsEnabled="{Binding Available}"
                        CommandParameter="{Binding Path}" ToolTip="{Binding Path}"
                        Command="{Binding DataContext.OpenPlaceCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Foreground="{DynamicResource FgMuted}" />
                      <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource DriveBar}" Margin="24,5,4,2"
                                 Value="{Binding UsedFraction, Mode=OneWay, FallbackValue=0}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1,1,0,0" CornerRadius="4,0,0,0" ClipToBounds="True">
        <Grid>
          <ListView x:Name="List" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource Row}"
                    Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                    IsTextSearchEnabled="True" TextSearch.TextPath="Name" AllowDrop="True"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectionChanged="OnSelectionChanged"
                    MouseDoubleClick="OnListDoubleClick"
                    PreviewMouseLeftButtonDown="OnListMouseDown"
                    PreviewMouseRightButtonDown="OnListRightButtonDown"
                    PreviewMouseMove="OnListMouseMove"
                    ContextMenuOpening="OnListContextMenuOpening"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop"
                    GridViewColumnHeader.Click="OnHeaderClick">

            <ListView.InputBindings>
              <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
              <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
              <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentlyCommand}" />
              <KeyBinding Key="Enter" Command="{Binding OpenSelectionCommand}" />
              <KeyBinding Key="Back" Command="{Binding UpCommand}" />
            </ListView.InputBindings>

            <ListView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open" Command="{Binding OpenSelectionCommand}" InputGestureText="Enter" />
                <Separator />
                <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                <MenuItem Header="Delete permanently" Command="{Binding DeletePermanentlyCommand}" InputGestureText="Shift+Del" />
                <Separator />
                <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N" />
              </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="Name" HeaderTemplate="{StaticResource NameHeaderTemplate}" Width="380">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel x:Name="Cell" Orientation="Horizontal">
                        <Image Width="16" Height="16" Margin="0,0,10,0" Source="{Binding Icon}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                          <Setter TargetName="Cell" Property="Opacity" Value="0.55" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Size" HeaderTemplate="{StaticResource SizeHeaderTemplate}" Width="100">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Kind" HeaderTemplate="{StaticResource KindHeaderTemplate}" Width="140"
                                DisplayMemberBinding="{Binding KindText}" />
                <GridViewColumn Header="Modified" HeaderTemplate="{StaticResource ModifiedHeaderTemplate}" Width="170"
                                DisplayMemberBinding="{Binding ModifiedText}" />
              </GridView>
            </ListView.View>
          </ListView>

          <TextBlock Text="{Binding ListMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="24,60,24,0" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource FgMuted}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
