<Window x:Class="Oan.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}">

  <Window.Resources>
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource FieldBg}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="18">
    <TextBox x:Name="Input" Height="32" />
    <PasswordBox x:Name="Secret" Height="32" Visibility="Collapsed" Padding="8,0" VerticalContentAlignment="Center"
                 Foreground="{DynamicResource Fg}" Background="{DynamicResource FieldBg}"
                 BorderBrush="{DynamicResource Border}" CaretBrush="{DynamicResource Fg}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" IsDefault="True" Click="OnAccept" Style="{StaticResource DialogButton}" />
      <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
    </StackPanel>
  </StackPanel>
</Window>
