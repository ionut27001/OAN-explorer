<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>oan.ico</ApplicationIcon>
    <AssemblyName>Oan</AssemblyName>
    <RootNamespace>Oan.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also a resource, not only the exe's icon: the title bar draws it. -->
    <Resource Include="oan.ico" />
    <ProjectReference Include="..\Oan.Core\Oan.Core.csproj" />
    <InternalsVisibleTo Include="Oan.Tests" />
  </ItemGroup>
</Project>
