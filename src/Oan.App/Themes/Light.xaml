<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <!-- The selected tab at partial strength. Tab hover uses it rather than the generic Hover wash,
       so a hovered tab can never read as brighter than the selected one, on any backdrop. -->
  <SolidColorBrush x:Key="SurfaceSoft" Color="#59FFFFFF" />
  <SolidColorBrush x:Key="Fg" Color="#1B1B1B" />
  <SolidColorBrush x:Key="FgMuted" Color="#5D5D5D" />
  <SolidColorBrush x:Key="FgDim" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Border" Color="#E2E2E2" />
  <SolidColorBrush x:Key="Accent" Color="#0067C0" />
  <SolidColorBrush x:Key="Warning" Color="#B03030" />
  <SolidColorBrush x:Key="Hover" Color="#12000000" />
  <SolidColorBrush x:Key="Pressed" Color="#20000000" />
  <SolidColorBrush x:Key="Selected" Color="#CCE4F7" />
  <SolidColorBrush x:Key="SelectedFg" Color="#1B1B1B" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#8A8A8A" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#5D5D5D" />
  <!-- The caption band, the one strip above the layer. It keeps most of the backdrop, but not all
       of it: acrylic samples whatever window is behind, and over a white one the tab titles and the
       window buttons were measured at 1.31:1. It is also what the selected tab stands out from, so
       it stays a step darker than the layer. -->
  <SolidColorBrush x:Key="Caption" Color="#66FFFFFF" />


  <!-- A shade off Surface: on a white sheet an all-white field is held together
       by its 1px outline alone, and that outline measures 1.30:1. -->
  <SolidColorBrush x:Key="FieldBg" Color="#F9F9F9" />

</ResourceDictionary>
