<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="WindowBg" Color="#202020" />
  <SolidColorBrush x:Key="Surface" Color="#282828" />
  <!-- The selected tab at partial strength, so a hovered tab never reads as brighter than the selected one. -->
  <SolidColorBrush x:Key="SurfaceSoft" Color="#59282828" />
  <SolidColorBrush x:Key="Fg" Color="#F0F0F0" />
  <SolidColorBrush x:Key="FgMuted" Color="#A8A8A8" />
  <SolidColorBrush x:Key="FgDim" Color="#969696" />
  <SolidColorBrush x:Key="Border" Color="#3C3C3C" />
  <SolidColorBrush x:Key="Accent" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Warning" Color="#FF8A8A" />
  <SolidColorBrush x:Key="Hover" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="Pressed" Color="#28FFFFFF" />
  <SolidColorBrush x:Key="Selected" Color="#0F4676" />
  <SolidColorBrush x:Key="SelectedFg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#6B6B6B" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#9A9A9A" />
  <!-- The caption band. Not fully clear: over a white window behind acrylic, the tab titles measured
       1.31:1. A step darker than the layer, so the selected tab stands out from it. -->
  <SolidColorBrush x:Key="Caption" Color="#66000000" />


  <SolidColorBrush x:Key="FieldBg" Color="#333333" />

  <!-- Menus and anything else that opens over the window: opaque whatever a theme does to Surface. -->
  <SolidColorBrush x:Key="MenuBg" Color="#2C2C2C" />

</ResourceDictionary>
